---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ToastContainer } from '@/components/ToastContainer'
import { ModalStack } from '@/components/ui/modal'
import Analytics from '@vercel/analytics/astro'
import SearchModal from '@/components/header/SearchModal.astro'
import { site } from '@/config.json'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <CommonHead title={title} description={description} image={image} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
    <script
      is:inline
      async
      defer
      src="https://um.mingcy.cn/script.js"
      data-website-id="2dec6bd6-3aa9-49f5-a7ec-cb0c23c74f44"></script>
    <script
      is:inline
      async
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="86be4560-edbf-468b-9897-813f94dfe6c3"></script>
    <!-- 朋友圈插件样式：放在 head 全局加载（Swup 切页不替换 head），避免 main 内 link 在切页后未加载导致卡片样式丢失 -->
    <link rel="stylesheet" href="/fclite/fclite.css" />
    <!-- Fancybox 图片灯箱样式（本地化，避免 CDN 被跟踪防护拦截） -->
    <link rel="stylesheet" href="/fancybox/fancybox.min.css" />
    <!-- Pagefind 搜索 UI 样式：head 全局加载，保证首次打开搜索模态框样式已就绪 -->
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <!-- Pagefind UI JS：低优先级预取，SearchModal hover/点击注入 script 时命中缓存。
         fetchpriority=low 不抢首屏带宽；163KB 首包从「点击后加载」变「页面加载后后台预取」，
         用户点击搜索时 script 通常已就绪，首次打开从等待加载变成直接开。 -->
    <link rel="preload" href="/pagefind/pagefind-ui.js" as="script" fetchpriority="low" />
  </head>
  <body>
    <!-- 全局壁纸背景：webp.mingcy.cn 随机壁纸 + 高斯模糊 + 明暗遮罩，避免影响文字。
         与右侧侧边栏卡片（.bg-shared-media）共用 :root 的 --random-bg-url，只下载一次 -->
    <div class="site-wallpaper" aria-hidden="true"></div>
    <div class="site-grain hidden-mobile pointer-events-none fixed inset-0 z-0" aria-hidden="true">
    </div>
    <script is:inline data-swup-ignore-script>
      // 注册背景图 Service Worker（仅 https/localhost，sw.js 在 public/ 根）
      // SW 拦截 webp.mingcy.cn 请求，Stale-While-Revalidate + 固定 KEY 缓存：
      //   首次走网络（慢，必然）；之后每次刷新命中缓存秒开，后台静默更新下一张。
      //   opaque response（no-cors）可被 cache.put 存、被 img/css 渲染，不需要 CORS 头。
      // data-swup-ignore-script：Swup 切页不重建 body，注册只跑一次。
      if (
        'serviceWorker' in navigator &&
        (location.protocol === 'https:' ||
          location.hostname === 'localhost' ||
          location.hostname === '127.0.0.1')
      ) {
        navigator.serviceWorker.register('/sw.js').catch(function () {})
      }
    </script>
    <script is:inline data-swup-ignore-script>
      // 随机壁纸：一次请求，多处复用 + Service Worker 跨刷新缓存
      //
      // 行为：未加载完 = 纯色背景（::before 无图 + opacity:0，露元素 background-color），
      //       decode 完成后才 apply → 设 CSS 变量 + 加 .bg-ready → 两处图片层 0.9s 淡入。
      //       SW 命中缓存时 new Image 秒级 load；首次访问无缓存走网络（慢，必然）。
      //       失败时静默，保持纯色占位（用户要的「没加载出来之前黑白纯色背景」）。
      // 全局背景层（.site-wallpaper）与右侧侧边栏卡片（.bg-shared-media）以前各自直连
      // webp.mingcy.cn，同一张随机图被下载两次，且两次返回结果不同 → 画面割裂。
      // 现在只发 1 次请求，把带时间戳的真实 URL 写入 :root 的 --random-bg-url，
      // 所有消费方统一读 background-image: var(--random-bg-url)。
      // Swup 切页不重建 body，此脚本只跑一次，SPA 导航期间壁纸保持稳定不闪变
      ;(function () {
        var docEl = document.documentElement
        var settled = false

        // 成功：写入 CSS 变量 + 加 .bg-ready → 两处图片层同步 0.9s 淡入
        function apply(url) {
          if (settled) return
          settled = true
          docEl.style.setProperty('--random-bg-url', "url('" + url + "')")
          docEl.classList.add('bg-ready')
        }

        var url = 'https://webp.mingcy.cn?v=' + Date.now()
        var img = new Image()
        img.addEventListener('load', function () {
          // decode() 保证帧已解码，写入变量时不闪；不支持/失败时直接 apply（CSS 渲染仍可用）
          if (typeof img.decode === 'function') {
            img.decode().then(function () {
              apply(url)
            }, function () {
              apply(url)
            })
          } else {
            apply(url)
          }
        })
        img.addEventListener('error', function () {
          // 静默：保持纯色占位，不强制显示兜底图（用户要的就是「没加载完纯色」）
        })
        img.src = url
      })()
    </script>

    <slot />

    <BackToTopFAB client:only="react" />
    <ToastContainer client:only="react" />
    <ModalStack client:only="react" />
    <Analytics />
    <script is:inline>
      // Swup 切页前（main 内容替换前）通知 main 内所有 React island 释放
      // 定时器/rAF/观察器/监听器，防止旧实例泄漏导致页面切换卡顿
      document.addEventListener('swup:content:replace', () => {
        document.dispatchEvent(new CustomEvent('mcy:island-cleanup'))
      })
    </script>
    <script is:inline>
      // 滚动时临时移除 backdrop-filter（毛玻璃是滚动重绘卡顿的主因），
      // 滚动停止 120ms 后恢复玻璃效果；配合 body.is-scrolling 的 CSS 降级规则
      ;(function () {
        var ticking = false
        var timer = null
        var onScroll = function () {
          if (ticking) return
          ticking = true
          requestAnimationFrame(function () {
            document.body.classList.add('is-scrolling')
            ticking = false
            clearTimeout(timer)
            timer = setTimeout(function () {
              document.body.classList.remove('is-scrolling')
            }, 120)
          })
        }
        window.addEventListener('scroll', onScroll, { passive: true })
      })()
    </script>
    <script is:inline>
      // 代码块复制按钮（委托到 document，Swup 切页后依然生效）
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.copy-code')
        if (!btn) return
        var block = btn.closest('.code-block')
        var pre = block ? block.querySelector('pre') : null
        var text = pre ? pre.innerText : ''
        if (!text) return
        navigator.clipboard
          .writeText(text)
          .then(function () {
            btn.textContent = '已复制 ✓'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 800)
          })
          .catch(function () {
            btn.textContent = '复制失败'
            setTimeout(function () {
              btn.textContent = '复制'
            }, 1200)
          })
      })
    </script>
    <script is:inline>
      // 朋友圈页（/links/fcircle）初始化：Swup 切页后 main 容器内的 inline 脚本不会重新执行，
      // 会导致插件区空白、友链状态卡"加载中"。故在此 body 级常驻脚本统一处理，
      // 页面首次加载与 Swup 切页后自动触发（插件加载 + 友链状态）。
      ;(function () {
        var FCLITE_JS = '/fclite/fclite.js'

        // 插件配置（fclite.js 初始化依赖，Swup 切页后 main 内的 UserConfig 不会重跑）
        window.UserConfig = window.UserConfig || {
          private_api_url: 'https://fc.mingcy.cn/',
          page_turning_number: 24,
          error_img: '/fclite/avatar-fallback.svg',
        }

        function ensureFclite(cb) {
          if (typeof initialize_fc_lite === 'function') {
            cb()
            return
          }
          if (document.querySelector('script[data-fclite]')) return
          var s = document.createElement('script')
          s.src = FCLITE_JS
          s.setAttribute('data-fclite', '1')
          s.onload = cb
          // 加载失败：清除标记，稍后随下一次 boot 重试
          s.onerror = function () {
            s.removeAttribute('data-fclite')
            setTimeout(boot, 1000)
          }
          document.head.appendChild(s)
        }

        function esc(t) {
          if (!t) return ''
          var d = document.createElement('div')
          d.textContent = t
          return d.innerHTML
        }

        // 确保 fclite.css 已加载（防 main 内 link 在 Swup 切页后未应用）
        function ensureFcliteCss() {
          var found = false
          for (var i = 0; i < document.styleSheets.length; i++) {
            var href = document.styleSheets[i].href || ''
            if (href.indexOf('/fclite/fclite.css') !== -1) {
              found = true
              break
            }
          }
          if (!found && !document.querySelector('link[data-fclite-css]')) {
            var l = document.createElement('link')
            l.rel = 'stylesheet'
            l.href = '/fclite/fclite.css'
            l.setAttribute('data-fclite-css', '1')
            document.head.appendChild(l)
          }
        }

        function boot() {
          ensureFcliteCss()

          // 1) 插件动态流
          var root = document.getElementById('friend-circle-lite-root')
          if (root) {
            ensureFclite(function () {
              if (root.children.length === 0) initialize_fc_lite()
            })
          }

          // 2) 友链状态（data-state 防重复拉取）
          var summary = document.getElementById('links-summary')
          var grid = document.getElementById('links-grid')
          if (summary && summary.dataset.state !== 'done') {
            summary.dataset.state = 'done'
            fetch('https://fc.mingcy.cn/status.json')
              .then(function (r) {
                return r.json()
              })
              .then(function (data) {
                var links = data.link_status || []
                var ok = 0
                links.forEach(function (it) {
                  if (it.success) ok++
                })
                summary.innerHTML =
                  '<span class="stat-ok">' +
                  ok +
                  ' 正常</span>' +
                  '<span class="stat-sep">·</span>' +
                  '<span class="stat-fail">' +
                  (links.length - ok) +
                  ' 异常</span>'
                if (!grid) return
                grid.innerHTML = links
                  .map(function (item) {
                    var cls = item.success ? 'ok' : 'fail'
                    var label = item.success ? '正常' : '异常'
                    return (
                      '<a class="status-card ' +
                      cls +
                      '" href="' +
                      item.link +
                      '" target="_blank" rel="noopener" title="' +
                      esc(item.name) +
                      '">' +
                      '<span class="sc-indicator"></span>' +
                      '<span class="sc-name">' +
                      esc(item.name) +
                      '</span>' +
                      '<span class="sc-label">' +
                      label +
                      '</span></a>'
                    )
                  })
                  .join('')
              })
              .catch(function () {
                summary.textContent = '暂无数据'
              })
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot)
        } else {
          setTimeout(boot, 200)
          setTimeout(boot, 800)
        }
        // Swup 4 替换后事件：page:view（@swup/astro 在替换完成后派发，同时触发 astro:page-load）
        document.addEventListener('swup:page:view', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
        document.addEventListener('astro:page-load', function () {
          setTimeout(boot, 150)
          setTimeout(boot, 700)
        })
      })()
    </script>
    <!-- 评论系统驱动控制器：Twikoo / Waline 双引擎切换 -->
    <script is:inline>
      // ────────────────────────────────────────────────
      // 为什么控制器放在 Layout（而不是评论组件里）：
      //   Swup 切页只替换 <main>、不重建 body，本脚本常驻单例；
      //   main 内的 inline 脚本由 SwupScriptsPlugin 每次重跑，
      //   若在组件内初始化，每切一篇文章就新建一个评论实例且旧的永不销毁。
      // 两个引擎都按需懒加载：Twikoo 351KB（官方 CDN，2.0.17 twikoo.min.js）/ Waline 262KB（本地），
      //   只有用户真的切到对应系统才下载，首页与无评论页零成本。
      // ────────────────────────────────────────────────
      ;(function () {
        var KEY = 'mcy-comment-driver'
        var TWIKOO_ENV_ID = 'https://twikoo.mingcy.cn/'
        // 官方 CDN：jsDelivr 主源 + unpkg 备源（版本钉死 2.0.17，
        // 与云函数 twikoo-vercel 2.0.17 对齐；本地 public/twikoo/ 已删除）
        // 2.0 起官方文档改为推荐 twikoo.min.js（351KB），比 1.7 的 twikoo.all.min.js（772KB）小一半
        var TWIKOO_JS = [
          'https://cdn.jsdelivr.net/npm/twikoo@2.0.17/dist/twikoo.min.js',
          'https://unpkg.com/twikoo@2.0.17/dist/twikoo.min.js',
        ]
        var WALINE_SERVER = 'https://waline.mingcy.cn'
        var WALINE_JS = '/waline/waline.js'
        var WALINE_CSS = '/waline/waline.css'

        var twikooScript = null
        var twikooTryIndex = 0
        var walinePromise = null
        var walineInstance = null
        var walinePath = null
        var shownDriver = null

        function block() {
          return document.getElementById('comment-block')
        }

        function readDriver() {
          try {
            return localStorage.getItem(KEY) === 'waline' ? 'waline' : 'twikoo'
          } catch (e) {
            return 'twikoo'
          }
        }

        function writeDriver(driver) {
          try {
            localStorage.setItem(KEY, driver)
          } catch (e) {}
        }

        // 懒加载指示器：只跟随当前展示的系统，避免用户已切走后误关别人的加载态
        function setLoader(driver, on, error) {
          if (driver !== shownDriver) return
          var b = block()
          var el = b ? b.querySelector('.driver-loading') : null
          if (!el) return
          if (on) {
            el.hidden = false
            var text = el.querySelector('.driver-loading__text')
            if (text) {
              text.textContent = error
                ? error
                : driver === 'waline'
                  ? '正在加载 Waline 评论…'
                  : '正在加载 Twikoo 评论…'
            }
            el.setAttribute('data-error', error ? '1' : '0')
          } else {
            el.hidden = true
            el.removeAttribute('data-error')
          }
        }

        function syncUI(driver) {
          var b = block()
          if (!b) return
          shownDriver = driver
          b.querySelectorAll('.comment-driver').forEach(function (el) {
            // 用 data-engine 而非 id：Twikoo 的 Vue 2 $mount 会替换掉 #twikoo 节点，
            // 替换后 id 就没了，而外层 data-engine 壳始终存在
            el.classList.toggle('is-active', el.getAttribute('data-engine') === driver)
          })
          b.querySelectorAll('.driver-switch__btn').forEach(function (btn) {
            var on = btn.getAttribute('data-driver') === driver
            btn.classList.toggle('is-active', on)
            btn.setAttribute('aria-selected', on ? 'true' : 'false')
            btn.tabIndex = on ? 0 : -1
          })
          var track = b.querySelector('.driver-switch__track')
          if (track) {
            if (!window.__mcyCommentDriverSynced) {
              // 首次同步：避免高亮块从默认位滑动到记忆位的多余动画
              track.style.transition = 'none'
            }
            track.style.transform = driver === 'waline' ? 'translateX(100%)' : 'translateX(0)'
            if (!window.__mcyCommentDriverSynced) {
              requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                  track.style.transition = ''
                })
              })
            }
          }
          window.__mcyCommentDriverSynced = true
        }

        // ─── Twikoo（官方 CDN 懒加载，只有切到本引擎才下载） ───
        // Twikoo 用 Vue 2 的 $mount('#twikoo')，会把 #twikoo 节点整个替换掉；
        // 因此幂等标记 data-ready 必须打在永不被替换的外层壳上。
        function twikooSlot() {
          return document.querySelector('#comment-block .comment-driver[data-engine="twikoo"]')
        }

        // ─── 把 Twikoo 运行时注入的 <style> 挪出 <head> ───
        // Twikoo 的 CSS 不是文件：twikoo.all.min.js 内是 webpack vue-style-loader
        // 内联样式，脚本首次加载时一次性往 document.head 注入若干个 <style>
        // （v2.0.17 实测仍在 30KB 量级），之后无论再调用多少次 twikoo.init() 都不会重新
        // 注入（webpack 模块已缓存）。
        // 而 @swup/astro 默认开启 updateHead（@swup/head-plugin），它挂在
        // before("content:replace")：每次切页都会把 <head> 里「下一页静态 HTML 的
        // head 中不存在」的元素全部 removeChild。Twikoo 的 16 个 <style> 正是
        // 运行时注入、静态 HTML 里不存在 → 切页一次就被删掉且永不补回，
        // 于是第二篇文章起评论样式全部丢失（首篇正常，之后永久失效）。
        // 识别只能靠内容：vue-style-loader 注入的 <style> 连 data-vue-ssr-id
        // 属性都没有（bundle 内 ssrId 为假值）。且这 16 个片段并不都属于 twikoo 自己的
        // 命名空间 —— 实测分布：
        //   .tk-*   twikoo 本体（评论列表 / 提交 / 分页 / 管理面板…）
        //   .el-*   Element UI（按钮 / 文本域 / 标签…，约占 49% 体积）
        //   OwO     表情面板
        // 只匹配 tk-comment 只能覆盖 15% 的样式，三个特征必须都认。
        // <style> 挪到 <body> 后依然全文档生效，且不属 head 清理范围；
        // 本站 head 内的内联样式只有随机强调色变量（不含 tk-/el-/OwO），不会误伤。
        // 函数幂等，重复调用只是空转。
        function adoptTwikooStyles() {
          var styles = document.head.querySelectorAll('style')
          for (var i = 0; i < styles.length; i++) {
            var st = styles[i]
            var css = st.textContent || ''
            if (css.indexOf('tk-') === -1 && css.indexOf('el-') === -1 && css.indexOf('OwO') === -1) {
              continue
            }
            document.body.appendChild(st)
          }
        }

        function initTwikoo() {
          var slot = twikooSlot()
          if (!slot || slot.getAttribute('data-ready')) return
          if (typeof twikoo !== 'undefined' && twikoo.init) {
            mountTwikoo()
            return
          }
          if (twikooScript) return // 上一次请求还在飞行（含 CDN 自动切换期间）
          setLoader('twikoo', true)
          loadTwikooScript()
        }

        // 多源加载：某个 CDN 被浏览器跟踪防护 / 网络拦截时自动换下一个源，
        // 两个源都失败才给用户报错（保持原有 onerror 提示行为不变）
        function loadTwikooScript() {
          if (twikooTryIndex >= TWIKOO_JS.length) {
            setLoader('twikoo', true, 'Twikoo 加载失败，请刷新重试')
            return
          }
          twikooScript = document.createElement('script')
          twikooScript.src = TWIKOO_JS[twikooTryIndex++]
          twikooScript.onload = function () {
            // CSS 就是脚本加载这一刻注入 head 的，必须马上挪走；
            // 一旦等到 Swup 切页之后才挪，@swup/head-plugin 已经删掉了
            adoptTwikooStyles()
            mountTwikoo()
          }
          twikooScript.onerror = function () {
            twikooScript = null
            loadTwikooScript()
          }
          document.head.appendChild(twikooScript)
        }

        function mountTwikoo() {
          var slot = twikooSlot()
          if (!slot || slot.getAttribute('data-ready')) return
          if (typeof twikoo === 'undefined' || !twikoo.init) {
            setLoader('twikoo', true, 'Twikoo 加载失败，请刷新重试')
            return
          }
          slot.setAttribute('data-ready', '1')
          setLoader('twikoo', false)
          // 兜底（幂等）：覆盖 onload 之外的所有挂载路径
          adoptTwikooStyles()
          twikoo.init({ envId: TWIKOO_ENV_ID, el: '#twikoo' })
        }

        // ─── Waline（本地化 /waline/） ───
        function ensureWalineCss() {
          if (document.querySelector('link[data-waline-css]')) return
          var link = document.createElement('link')
          link.rel = 'stylesheet'
          link.href = WALINE_CSS
          link.setAttribute('data-waline-css', '1')
          // 挂到 <body> 而非 <head>：<link> 放 body 是合法 HTML5，
          // 而 @swup/head-plugin 只清理 <head> 子节点 —— 放 head 里每个 Swup 切页
          // 都会把它删掉（ensureWalineCss 下次虽会重挂自愈），
          // 中间仍会出现 150~300ms 的 Waline 无样式窗口
          document.body.appendChild(link)
        }

        function destroyWaline() {
          if (!walineInstance) return
          try {
