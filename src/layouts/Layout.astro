         项逐个 IntersectionObserver observe，滚进视口（rootMargin:0，不预取）才
         scan(item) 只增强那一张 → 真·懒加载，不再一次性拉全部素材。
         并发上限 MAX_CONCURRENT=2（12 个 .pvt 共 ~16.7MB 并发下载会把带宽和 CPU
         同时打满）；generation token 让切页后旧队列立即作废。
         标 data-swup-ignore-script：监听器挂 document，Swup 永不替换；
         不加会被每切一次页克隆重跑、监听器无限累加。 -->
    <script is:inline data-swup-ignore-script>
      (function () {
        var observer = null
        /* 并发上限：无限制地逐个 scan 会让 12 个 .pvt（1-2.6MB/个）同时下载+解压，
           既打满带宽又把 CPU 占满（页面卡死）。 */
        var MAX_CONCURRENT = 2
        var queue = []
        var active = 0
        /* generation 递增：切页后旧队列立即作废，不再追加新下载（防止切到别的页面
           后还在后台拉 16MB .pvt，拖慢新页面）。 */
        var generation = 0
        function scanItem(item, done) {
          if (typeof HeoLivePhoto === 'undefined' || !HeoLivePhoto.scan) return done()
          try {
            var r = HeoLivePhoto.scan(item)
            if (r && r.then) r.then(done, done)
            else done()
          } catch (e) { done() }
        }
        function setup() {
          generation++
          var gen = generation
          queue = []
          active = 0
          var liveImgs = document.querySelectorAll('img[data-live-pvt], img[data-live-motion], img[data-live-video]')
          if (!liveImgs.length) return
          // 切页后旧 observer 失效，重建
          if (observer) observer.disconnect()
          if (!('IntersectionObserver' in window)) {
            // 不支持 IO 的浏览器直接全量初始化
            liveImgs.forEach(function (img) {
              var item = img.closest('[data-fancybox]') || img.parentElement
              if (item) scanItem(item, function () {})
            })
            return
          }
          // 出队：同时最多 MAX_CONCURRENT 个 .pvt 在下载/解压，其余排队
          function flush() {
            if (gen !== generation) return
            while (active < MAX_CONCURRENT && queue.length) {
              var item = queue.shift()
              active++
              scanItem(item, function () {
                if (gen !== generation) return
                active--
                flush()
              })
            }
          }
          observer = new IntersectionObserver(function (entries) {
            if (gen !== generation) return
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return
              observer.unobserve(entry.target)   // 只入队一次
              queue.push(entry.target)
            })
            flush()
          }, {
            root: null,
            // rootMargin:0 —— 只解包真正滚进视口的那张。之前 200px 会把首屏全部项
            // 一次性推入队列并发下载，是页面加载慢的主因。
            rootMargin: '0px',
            threshold: 0
          })
          liveImgs.forEach(function (img) {
            var item = img.closest('[data-fancybox]') || img.parentElement
            if (item && !img.dataset.liveReady) observer.observe(item)
          })
        }
        document.addEventListener('swup:page:view', function () { setTimeout(setup, 200) })
        document.addEventListener('astro:page-load', function () { setTimeout(setup, 200) })
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(setup, 0) })
        else setTimeout(setup, 0)
      })()
    </script>
    <!-- 全站搜索模态框（Pagefind UI，body 级常驻，Swup 不替换） -->
    <SearchModal />
  </body>
</html>
