---
// ============================================================================
// HomeCover.astro —— 首页「随机文章头图背景」+ 全局悬浮「推荐文章」胶囊
//
// 定位（本轮重做）：
//   组件挂在 Layout.astro 的 <slot /> 之后 —— 也就是 Swup 只替换 <main>，
//   本组件位于 <main> 之外，页面切换时【不会被销毁重建】。
//   胶囊用 position: fixed 锚定【浏览器视口】左下角：
//     桌面 left 24px / bottom 24px
//     手机 left 14px / bottom calc(16px + env(safe-area-inset-bottom))
//   这样祖先上的 transform / contain / overflow（Swup 过渡会加 transform）
//   都不会把它变成“页面内元素”，滚动时恒定不动。
//
// 只在首页显示：
//   - 标记 hidden 默认隐藏，脚本判定 pathname === '/' 才显示；
//   - Swup 导航（swup:page:view / astro:page-load）时重新判定，进/出首页自动切换；
//   - 脚本带 data-swup-ignore-script + 幂等守卫，Swup 不会重复执行。
//
// 随机轮换（沿用上一轮已验证的机制，改为端点取候选）：
//   localStorage['mcy-home-rotate-v1'] = { v:1, current, next }
//   整页加载到首页 → 用上次的 next 当当前，再抽下一篇并预取；
//   同一文档内 Swup 返回首页 → 复用 window.__mcyHomePick，不轮换、不重复预取。
// ============================================================================
---

<div class="home-recommend" data-home-recommend hidden>
  <a class="home-recommend__pill" href="/archives" data-home-recommend-link title="推荐文章">
    <svg
      class="home-recommend__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"></path>
    </svg>
    <span>推荐文章</span>
    <svg
      class="home-recommend__arrow"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h13"></path>
      <path d="M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>

<script is:inline data-swup-ignore-script>
  ;(function () {
    // 只执行一次：本脚本在 <main> 之外，但 SwupScriptsPlugin 会扫描整个 document
    // 并重新执行未标记 ignore 的脚本 —— 两个守卫都加上，避免重复绑定。
    if (window.__mcyHomeFloatBound) return
    window.__mcyHomeFloatBound = true

    var KEY = 'mcy-home-rotate-v1'
    var FALLBACK = 'https://webp.mingcy.cn?v=' + Date.now()
    var pill = document.querySelector('[data-home-recommend]')
    var link = document.querySelector('[data-home-recommend-link]')
    var docEl = document.documentElement

    // 本脚本只在整页加载时执行一次 → 这里的 pathname 就是「初始页面」
    var loadedOnHome = location.pathname === '/' || location.pathname === '/index.html'
    var list = null
    var listPromise = null
    var settled = false

    function isHome() {
      return location.pathname === '/' || location.pathname === '/index.html'
    }

    function showPill() {
      if (pill) pill.hidden = false
    }
    function hidePill() {
      if (pill) pill.hidden = true
    }

    function applyBg(url) {
      if (settled) return
      settled = true
      docEl.style.setProperty('--random-bg-url', "url('" + url + "')")
      docEl.classList.add('bg-ready')
    }

    function load(url, onDone) {
      var img = new Image()
      img.addEventListener('load', function () {
        if (typeof img.decode === 'function') img.decode().then(onDone, onDone)
        else onDone()
      })
      img.addEventListener('error', function () {
        onDone(false)
      })
      img.src = url
    }

    function fetchList() {
      if (list) return Promise.resolve(list)
      if (listPromise) return listPromise
      listPromise = fetch('/home-covers.json')
        .then(function (r) {
          if (!r.ok) throw new Error(String(r.status))
          return r.json()
        })
        .then(function (json) {
          list = Array.isArray(json) ? json : []
          return list
        })
        .catch(function () {
          list = []
          return list
        })
      return listPromise
    }

    function find(cover) {
      for (var i = 0; i < list.length; i++) if (list[i].cover === cover) return list[i]
      return null
    }

    function pickRandom(exclude) {
      if (!list.length) return null
      var pool = []
      for (var i = 0; i < list.length; i++) {
        if (exclude && exclude.indexOf(list[i].cover) !== -1) continue
        pool.push(list[i])
      }
      if (!pool.length) pool = list
      return pool[Math.floor(Math.random() * pool.length)]
    }

    function readState() {
      try {
        var s = JSON.parse(localStorage.getItem(KEY) || 'null')
        return s && s.v === 1 ? s : null
      } catch (e) {
        return null
      }
    }
    function writeState(cur, nxt) {
      try {
        localStorage.setItem(KEY, JSON.stringify({ v: 1, current: cur, next: nxt }))
      } catch (e) {}
    }

    function setPill(item) {
      if (!link || !item) return
      link.setAttribute('href', item.url)
      link.setAttribute('title', '推荐文章：' + item.title)
      link.setAttribute('aria-label', '推荐文章：' + item.title)
    }

    function prefetchNext(nxt) {
      var conn = navigator.connection
      if (conn && conn.saveData) return
      var run = function () {
        var img = new Image()
        img.decoding = 'async'
        img.src = nxt.cover
      }
      if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 3000 })
      else setTimeout(run, 1500)
    }

    function bootHome() {
      showPill()
      fetchList().then(function () {
        if (!isHome()) return // 等待期间已经离开首页
        if (!list.length) {
          load(FALLBACK, function (ok) {
            if (ok !== false) applyBg(FALLBACK)
          })
          return
        }

        var cur = null
        var nxt = null
        var shouldAdvance = loadedOnHome && !window.__mcyHomePick
        var state = readState()

        if (window.__mcyHomePick) {
          // 同一文档内（Swup 回到首页）：复用，不轮换
          cur = find(window.__mcyHomePick.cover) || window.__mcyHomePick
        } else if (shouldAdvance && state && state.next && find(state.next.cover)) {
          cur = find(state.next.cover)
        } else if (state && state.current && find(state.current.cover)) {
          cur = find(state.current.cover)
        } else {
          cur = pickRandom(null)
        }

        if (shouldAdvance) {
          nxt = pickRandom(cur ? [cur.cover] : null)
          if (cur) writeState(cur, nxt)
        } else if (!state || !state.next) {
          nxt = pickRandom(cur ? [cur.cover] : null)
          if (cur) writeState(cur, nxt)
        } else {
          nxt = find(state.next.cover) || pickRandom(cur ? [cur.cover] : null)
        }

        window.__mcyHomePick = cur
        setPill(cur)

        load(cur.cover, function (ok) {
          if (ok === false) {
            load(FALLBACK, function (ok2) {
              if (ok2 !== false) applyBg(FALLBACK)
            })
            return
          }
          applyBg(cur.cover)
        })

        if (nxt && cur && nxt.cover !== cur.cover) prefetchNext(nxt)
      })
    }

    function sync() {
      if (isHome()) bootHome()
      else hidePill()
    }

    // 首次（脚本在 body 末尾，DOM 已就绪）
    sync()

    // Swup / Astro 切页后重新判定「是不是首页」
    document.addEventListener('swup:page:view', function () {
      setTimeout(sync, 60)
    })
    document.addEventListener('astro:page-load', function () {
      setTimeout(sync, 60)
    })
  })()
</script>

<style>
  /* ═══════════════════════════════════════════════════════════
     全局悬浮胶囊：fixed 锚定视口左下角
     · 桌面 24 / 24
     · 手机 14 / 16 + 安全区
     层级：低于导航（1000）与模态框，高于正文/FAB（10）
     ═══════════════════════════════════════════════════════════ */
  .home-recommend {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 40;
    display: flex;
    justify-content: flex-start;
    /* fixed 元素不参与布局，不会被 Swup 的 transform/overflow 裁切 */
    contain: none;
  }

  /* hidden 属性必须压过 display:flex（UA 的 [hidden]{display:none} 优先级不够） */
  .home-recommend[hidden] {
    display: none !important;
  }

  .home-recommend__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    height: 2.25rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-border-primary) / 0.5);
    background: rgb(var(--color-bg-primary) / 0.42);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    backdrop-filter: blur(10px) saturate(160%);
    color: rgb(var(--color-text-primary) / 0.82);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.32),
      0 10px 26px -20px rgb(var(--color-text-primary) / 0.7);
    transition:
      color 0.22s ease,
      background-color 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .home-recommend__pill:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-bg-primary) / 0.55);
    border-color: rgb(var(--color-accent) / 0.38);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 12px 30px -20px rgb(var(--color-accent) / 0.55);
    transform: translateY(-1px);
  }

  .home-recommend__pill:active {
    transform: translateY(0) scale(0.985);
  }

  .home-recommend__pill:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .home-recommend__icon {
    width: 0.92rem;
    height: 0.92rem;
    flex-shrink: 0;
    color: rgb(var(--color-accent));
    opacity: 0.9;
  }

  .home-recommend__arrow {
    width: 0.86rem;
    height: 0.86rem;
    flex-shrink: 0;
    opacity: 0.45;
    transition:
      transform 0.22s ease,
      opacity 0.22s ease;
  }

  .home-recommend__pill:hover .home-recommend__arrow {
    transform: translateX(2px);
    opacity: 0.8;
  }

  :global(html[data-theme='dark']) .home-recommend__pill {
    border-color: rgb(var(--color-border-primary) / 0.75);
    background: rgb(var(--color-bg-secondary) / 0.42);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 10px 26px -20px rgb(0 0 0 / 0.9);
  }

  :global(html[data-theme='dark']) .home-recommend__pill:hover {
    background: rgb(var(--color-bg-secondary) / 0.62);
  }

  /* 手机：贴视口左下角，避开 iOS 底部安全区（Home Indicator） */
  @media (max-width: 640px) {
    .home-recommend {
      left: 14px;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    .home-recommend__pill {
      height: 2.1rem;
      padding: 0 0.75rem;
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-recommend__pill,
    .home-recommend__arrow {
      transition: none;
    }

    .home-recommend__pill:hover,
    .home-recommend__pill:active {
      transform: none;
    }

    .home-recommend__pill:hover .home-recommend__arrow {
      transform: none;
    }
  }
</style>
