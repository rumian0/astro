---
// ============================================================================
// HomeCover.astro —— 首页「随机文章头图背景」+ 页面区域左下角「推荐文章」胶囊
//
// 定位：胶囊锚定在 div.swup-transition-fade（PageLayout 里的页面区域）左下角；
//       该容器在首页加 .page-area--home → position: relative + 底部预留 4.5rem，
//       胶囊用 absolute 落在预留带里，不会压到文章列表/分页/页脚。
//       （不用 position: fixed：Swup 过渡期间祖先有 transform，fixed 会退化成
//        relative 而跳位；absolute 在过渡里跟着页面一起淡出，反而更稳。）
//
// 轮换（本次重点）：
//   localStorage['mcy-home-rotate-v1'] = { current, next }
//   ① 首次访问：随机 A 作为当前，随机 B 作为下一张，提前把 B 的图片拉进浏览器缓存
//   ② 刷新：直接取上次准备好的 next(B) 当当前，再准备 C
//   ③ 排除重复：抽 next 时排除 current 与上一张（文章数 > 2 时绝不会连续重复）
//   ④ Swup 返回首页：同一份文档里 window.__mcyHomePick 已存在 → 复用，不再轮换，
//      避免「每次切页都换背景」
//
// 一致性：背景图与胶囊 href/title 永远来自同一个 item 对象，不做两次随机。
// ============================================================================
import { getCollection } from 'astro:content'
import { getPostUrl } from '@/utils/content'

const posts = await getCollection('posts', ({ data }) => data.draft !== true)

// 排除 png（站内有 5.1MB / 3.5MB 的 PNG 封面），其余按 cover 去重
const isLightWeight = (url: string) => /\.(webp|jpe?g|avif|gif)(\?|#|$)/i.test(url)
const seen = new Set<string>()
const covers: { url: string; cover: string; title: string }[] = []

for (const post of posts) {
  const cover = post.data.cover
  if (!cover || !isLightWeight(cover) || seen.has(cover)) continue
  seen.add(cover)
  covers.push({ url: getPostUrl(post), cover, title: post.data.title })
}

// 无 JS 时的链接兜底：第一条候选（真实存在），不会是死链
const firstUrl = covers[0]?.url ?? '/archives'
---

<div class="home-recommend" data-home-recommend>
  <a class="home-recommend__pill" href={firstUrl} data-home-recommend-link title="推荐文章">
    <svg
      class="home-recommend__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"></path>
    </svg>
    <span>推荐文章</span>
    <svg
      class="home-recommend__arrow"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h13"></path>
      <path d="M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>

<script is:inline define:vars={{ covers }}>
  ;(function () {
    var list = covers || []
    var docEl = document.documentElement
    var KEY = 'mcy-home-rotate-v1'
    var FALLBACK = 'https://webp.mingcy.cn?v=' + Date.now()
    var mem = window.__mcyHomePick
    var settled = false

    // ── 背景写入：与 Layout 的壁纸脚本同一通道（CSS 变量 + html.bg-ready）──
    function applyBg(url) {
      if (settled) return
      settled = true
      docEl.style.setProperty('--random-bg-url', "url('" + url + "')")
      docEl.classList.add('bg-ready')
    }

    // ── 预载 + 解码成功后再淡入，避免「先露底色再跳图」──
    function load(url, onDone) {
      var img = new Image()
      img.addEventListener('load', function () {
        if (typeof img.decode === 'function') img.decode().then(onDone, onDone)
        else onDone()
      })
      img.addEventListener('error', function () {
        onDone(false)
      })
      img.src = url
    }

    // ── 候选查找 / 随机（排除若干 cover）──
    function find(cover) {
      for (var i = 0; i < list.length; i++) if (list[i].cover === cover) return list[i]
      return null
    }
    function pickRandom(exclude) {
      if (!list.length) return null
      var pool = []
      for (var i = 0; i < list.length; i++) {
        if (exclude && exclude.indexOf(list[i].cover) !== -1) continue
        pool.push(list[i])
      }
      // 候选不足时回退成全集（宁可重复，也不能没有背景）
      if (!pool.length) pool = list
      return pool[Math.floor(Math.random() * pool.length)]
    }

    function readState() {
      try {
        var s = JSON.parse(localStorage.getItem(KEY) || 'null')
        return s && s.v === 1 ? s : null
      } catch (e) {
        return null
      }
    }
    function writeState(s) {
      try {
        localStorage.setItem(KEY, JSON.stringify({ v: 1, current: s.current, next: s.next }))
      } catch (e) {}
    }

    // ── 决定「本次展示哪一篇」──
    var cur = null
    var nxt = null
    var advanced = false

    if (mem) {
      // 同一份文档内（Swup 返回首页）：复用，不轮换、不重复预加载
      cur = find(mem.cover) || mem
    } else {
      var state = readState()
      // ① 优先使用上次准备好的 next
      if (state && state.next) cur = find(state.next.cover)
      // ② 没有/失效 → 随机，并排除上次那篇
      if (!cur) {
        var lastCover = state && state.current && state.current.cover
        cur = pickRandom(lastCover ? [lastCover] : null)
      }
      // ③ 准备下一篇（排除当前与上次），并持久化
      nxt = pickRandom(cur ? [cur.cover] : null)
      if (cur) {
        writeState({ current: cur, next: nxt })
        advanced = true
      }
      window.__mcyHomePick = cur
    }

    // ── 胶囊：与背景共用同一个 item ──
    var link = document.querySelector('[data-home-recommend-link]')
    if (link && cur) {
      link.setAttribute('href', cur.url)
      link.setAttribute('title', '推荐文章：' + cur.title)
      link.setAttribute('aria-label', '推荐文章：' + cur.title)
    }

    // ── 没有可用封面 → 直接用站内随机壁纸 ──
    if (!cur) {
      load(FALLBACK, function (ok) {
        if (ok !== false) applyBg(FALLBACK)
      })
      return
    }

    // ── 当前头图：缓存命中时会立刻 load 完成；失败再回退站内随机壁纸 ──
    load(cur.cover, function (ok) {
      if (ok === false) {
        load(FALLBACK, function (ok2) {
          if (ok2 !== false) applyBg(FALLBACK)
        })
        return
      }
      applyBg(cur.cover)
    })

    // ── 后台预热「下一次刷新」用的那张图（只 1 张，空闲时执行）──
    if (advanced && nxt && nxt.cover !== cur.cover) {
      var conn = navigator.connection
      if (conn && conn.saveData) return // 省流模式不预取

      var prefetch = function () {
        var img = new Image()
        img.decoding = 'async'
        img.src = nxt.cover
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(prefetch, { timeout: 3000 })
      } else {
        setTimeout(prefetch, 1500)
      }
    }
  })()
</script>

<style>
  /* ─── 胶囊容器 ───
     锚定在 .swup-transition-fade.page-area--home（position: relative）的左下角。
     该区域在首页底部预留了 4.5rem，所以胶囊落在空白带里，
     不会压到文章卡片、分页器或页脚。 */
  .home-recommend {
    position: absolute;
    left: 1.25rem;
    bottom: 1.15rem;
    z-index: 20;
    display: flex;
    justify-content: flex-start;
  }

  /* ─── 胶囊本体：微透明 + 背景模糊 + 顶部 1px 高光 ─── */
  .home-recommend__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    height: 2.25rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-border-primary) / 0.5);
    background: rgb(var(--color-bg-primary) / 0.42);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    backdrop-filter: blur(10px) saturate(160%);
    color: rgb(var(--color-text-primary) / 0.82);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.32),
      0 10px 26px -20px rgb(var(--color-text-primary) / 0.7);
    transition:
      color 0.22s ease,
      background-color 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .home-recommend__pill:hover {
    color: rgb(var(--color-accent));
    background: rgb(var(--color-bg-primary) / 0.55);
    border-color: rgb(var(--color-accent) / 0.38);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 12px 30px -20px rgb(var(--color-accent) / 0.55);
    transform: translateY(-1px);
  }

  .home-recommend__pill:active {
    transform: translateY(0) scale(0.985);
  }

  .home-recommend__pill:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .home-recommend__icon {
    width: 0.92rem;
    height: 0.92rem;
    flex-shrink: 0;
    color: rgb(var(--color-accent));
    opacity: 0.9;
  }

  .home-recommend__arrow {
    width: 0.86rem;
    height: 0.86rem;
    flex-shrink: 0;
    opacity: 0.45;
    transition:
      transform 0.22s ease,
      opacity 0.22s ease;
  }

  .home-recommend__pill:hover .home-recommend__arrow {
    transform: translateX(2px);
    opacity: 0.8;
  }

  :global(html[data-theme='dark']) .home-recommend__pill {
    border-color: rgb(var(--color-border-primary) / 0.75);
    background: rgb(var(--color-bg-secondary) / 0.42);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 10px 26px -20px rgb(0 0 0 / 0.9);
  }

  :global(html[data-theme='dark']) .home-recommend__pill:hover {
    background: rgb(var(--color-bg-secondary) / 0.62);
  }

  /* 小屏：贴边距收窄一档，但仍保持 ≥ 32px 点击高度 */
  @media (max-width: 640px) {
    .home-recommend {
      left: 0.9rem;
      bottom: 0.9rem;
    }

    .home-recommend__pill {
      height: 2.1rem;
      padding: 0 0.75rem;
      font-size: 0.74rem;
    }
  }

  /* 动效降级 */
  @media (prefers-reduced-motion: reduce) {
    .home-recommend__pill,
    .home-recommend__arrow {
      transition: none;
    }

    .home-recommend__pill:hover,
    .home-recommend__pill:active {
      transform: none;
    }

    .home-recommend__pill:hover .home-recommend__arrow {
      transform: none;
    }
  }
</style>
