<div id="twikoo" class="mt-8"></div>
<script is:inline>
  (function() {
    var checkExist = setInterval(function() {
      if (document.getElementById('twikoo')) {
        clearInterval(checkExist);
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/twikoo/1.7.12/twikoo.all.min.js';
        script.onload = function() {
          twikoo.init({
            envId: 'https://twikoo.mingcy.cn/',
            el: '#twikoo',
          });
        };
        script.onerror = function() {
          var fallback = document.createElement('script');
          fallback.src = 'https://cdnjs.cloudflare.com/ajax/libs/twikoo/1.7.12/twikoo.all.min.js';
          fallback.onload = function() {
            twikoo.init({
              envId: 'https://twikoo.mingcy.cn/',
              el: '#twikoo',
            });
          };
          document.head.appendChild(fallback);
        };
        document.head.appendChild(script);
      }
    }, 500);
  })();
</script>
