---
import { ThemeSwitch } from './ThemeSwitch'
import { author, footer } from '@/config.json'
import { getAllPostsWordCount } from '@/utils/content'
import { RunningDays } from './RunningDays'
import SiteVisitors from './SiteVisitors.astro'
import Link from './Link.astro'

const sinceYear = new Date(footer.startTime).getFullYear()
const thisYear = new Date().getFullYear()
const copyDate = sinceYear === thisYear ? thisYear : `${sinceYear} - ${thisYear}`

const wordCount = await getAllPostsWordCount()

const wordCountStr = (wordCount / 1000).toFixed(1) + 'k'
---

<footer class="relative z-1 py-8 px-4 md:px-8 border-t border-primary text-secondary text-sm bg-primary/70">
  <div class="text-center space-y-2">
    <div>
      Powered by
      <Link href="https://astro.build/">Astro</Link>
      & Designed by
      <Link href="https://github.com/rumian0/astro-mingcy">MingCY</Link>
    </div>
    <div class="space-x-1">
      <span>&copy;{copyDate} <Link href="/">{author.name}</Link>.</span>
      <Link href="/rss.xml" data-no-swup>
        <i class="iconfont icon-rss"></i>
        <span>RSS</span>
      </Link>
      <Link href="/sitemap.xml" data-no-swup>
        <i class="iconfont icon-map"></i>
        <span>站点地图</span>
      </Link>
    </div>
    <div>
      <RunningDays client:only="react" />
      <span class="select-none opacity-50">|</span>
      <span>共嘚嘚了 {wordCountStr} 字</span>
      <span class="select-none opacity-50">|</span>
      <SiteVisitors />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3 pb-1">
      <a
        href="https://www.foreverblog.cn/about.html#ab-8"
        target="_blank"
        rel="noopener noreferrer"
        title="入选十年之约「今天读什么」"
        class="inline-flex items-center"
      >
        <img
          src="https://www.foreverblog.cn/assets/logo/daily_pick_v1_black.png?v=1"
          alt="入选十年之约「今天读什么」"
          width="auto"
          height="32"
          loading="lazy"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src="https://www.foreverblog.cn/assets/logo/daily_pick_v1_light.png?v=1"
          alt="入选十年之约「今天读什么」"
          width="auto"
          height="32"
          loading="lazy"
          class="hidden h-8 w-auto dark:block"
        />
      </a>
      <a
        href="https://www.travellings.cn/go.html"
        target="_blank"
        rel="noopener noreferrer"
        title="开往-友链接力"
        class="inline-flex items-center"
      >
        <img
          src="https://www.travellings.cn/assets/logo.gif"
          alt="开往-友链接力"
          width="120"
          height="32"
          loading="lazy"
          class="h-8 w-auto"
        />
      </a>
      <a
        href="https://rss.nooj.cn/b/836"
        target="_blank"
        rel="noopener noreferrer"
        title="博客雷达-中文独立博客收录"
        class="inline-flex items-center"
      >
        <!-- 168×60 徽章，按 h-8 等比缩放；浅色素纸 / 深色玄黑 -->
        <img
          src="https://rss.nooj.cn/badge/836.svg?style=paper"
          alt="茗辰原 已被博客雷达收录"
          width="168"
          height="60"
          loading="lazy"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src="https://rss.nooj.cn/badge/836.svg?style=ink"
          alt="茗辰原 已被博客雷达收录"
          width="168"
          height="60"
          loading="lazy"
          class="hidden h-8 w-auto dark:block"
        />
      </a>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
      <Link href="https://beian.miit.gov.cn/" data-no-swup>
        <span>豫ICP备2026043588号</span>
      </Link>
      <span class="select-none opacity-50">|</span>
      <Link href="https://beian.mps.gov.cn/#/index?code=65010602001220" data-no-swup>
        <img
          src="/beian/ghs.png"
          alt="公安备案图标"
          width="20"
          height="20"
          class="inline-block align-[-3px]"
        />
        <span>新公网安备65010602001220号</span>
      </Link>
    </div>
  </div>
  <div class="mt-4 flex justify-center">
    <ThemeSwitch client:only="react" />
  </div>
</footer>
