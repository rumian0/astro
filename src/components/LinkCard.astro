---
interface Props {
  title: string;
  url: string;
  desc?: string;
  image?: string;
}

const { title, url, desc, image } = Astro.props;
---

<a
  href={url}
  class="link-card not-prose my-4 inline-flex w-full items-center gap-3 rounded-2xl border border-border/25 p-4 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/35 hover:shadow-lg hover:shadow-accent/5 sm:w-[calc(50%-0.5rem)]"
  target="_blank"
  rel="noopener noreferrer"
>
  {
    image && (
      <span class="link-card-img flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-muted/20">
        <img src={image} alt="" class="size-full object-cover" loading="lazy" />
      </span>
    )
  }
  <span class="link-card-body flex min-w-0 flex-col gap-0.5">
    <span class="link-card-title truncate text-sm font-semibold text-foreground">
      {title}
    </span>
    {
      desc && (
        <span class="link-card-desc truncate text-xs text-foreground/55">
          {desc}
        </span>
      )
    }
  </span>
</a>
