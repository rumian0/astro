---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="友圈 - 茗辰原" description="朋友们的最新动态">
  <Header />
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="mb-2 text-center text-3xl font-bold text-white">朋友圈</h1>
    <p class="mb-8 text-center text-gray-400">聚合友链文章，了解朋友们在做什么</p>

    <div class="glass-card mb-6 rounded-2xl p-6">
      <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-cyan-300">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-green-400 animate-pulse" />
        友链状态
      </h2>
      <div class="rounded-xl bg-black/20 p-4 text-sm text-gray-400">
        加载中...
      </div>
    </div>

    <div class="glass-card overflow-hidden rounded-xl" style="height: calc(100vh - 240px);">
      <iframe src="https://fc.mingcy.cn/"
        class="h-full w-full border-0"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-forms"
        title="朋友圈">
      </iframe>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .glass-card { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.06); }
</style>
