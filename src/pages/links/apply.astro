---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Twikoo from "@/components/Twikoo.astro";
---

<Layout title="友链申请 - 茗辰原" description="申请与茗辰原交换友链">
  <Header />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-2 text-center text-3xl font-bold text-white">友链申请</h1>
    <p class="mb-8 text-center text-gray-400">想和茗辰原交换友链？请先阅读下面的申请说明</p>

    <div class="mb-4 flex gap-2 justify-center">
      <a href="/links/" class="rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-4 py-2 text-sm text-cyan-300 transition-colors hover:bg-cyan-500/20">查看友链</a>
    </div>

    <!-- 流程步骤 -->
    <div class="grid gap-4 mb-6 md:grid-cols-3">
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-cyan-500/20 text-lg font-bold text-cyan-300">01</div>
        <h3 class="mb-2 font-bold text-white">确认要求</h3>
        <p class="text-sm text-gray-400">确认贵站符合基本要求，并先添加本站友链</p>
      </div>
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-cyan-500/20 text-lg font-bold text-cyan-300">02</div>
        <h3 class="mb-2 font-bold text-white">整理信息</h3>
        <p class="text-sm text-gray-400">按照格式整理站点信息，尽量提供稳定可访问的头像链接</p>
      </div>
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-cyan-500/20 text-lg font-bold text-cyan-300">03</div>
        <h3 class="mb-2 font-bold text-white">提交申请</h3>
        <p class="text-sm text-gray-400">在页面底部评论区提交申请，审核通过后会添加并回复</p>
      </div>
    </div>

    <!-- 要求列表 -->
    <div class="glass-card mb-6 rounded-2xl p-6">
      <h2 class="mb-4 text-lg font-bold text-cyan-300">友链要求</h2>
      <ul class="space-y-3">
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>站点定位</strong> — 优先接受个人博客、技术笔记、生活记录等非强商业化站点</span>
        </li>
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>内容质量</strong> — 希望有稳定且真实的内容输出，避免整站搬运和 AI 批量灌水</span>
        </li>
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>合规底线</strong> — 站点不得包含违法违规、色情、赌博、侵权盗版等内容</span>
        </li>
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>访问体验</strong> — 站点应能稳定访问，尽量保证国内访问体验</span>
        </li>
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>互惠原则</strong> — 申请前请先添加本站友链，或在留言中说明预计添加时间</span>
        </li>
        <li class="flex gap-3 text-sm text-gray-300">
          <span class="mt-0.5 flex-shrink-0">📌</span>
          <span><strong>内容数量</strong> — 建议已有 <strong>15 篇以上</strong>文章，质量较高可放宽</span>
        </li>
      </ul>
    </div>

    <!-- 本站信息 -->
    <div class="glass-card mb-6 rounded-2xl p-6">
      <h2 class="mb-3 text-lg font-bold text-cyan-300">本站信息</h2>
      <p class="mb-2 text-sm text-gray-400">如果您愿意在贵站添加茗辰原，可以直接使用下面的信息：</p>
      <pre class="overflow-x-auto rounded-lg bg-black/30 p-4 text-sm text-gray-300">
name: 茗辰原
link: https://s.mingcy.cn
avatar: https://mingcy.cn/image/mcy.png
descr: 茶香四溢，编程世界</pre>
    </div>

    <!-- 申请格式 -->
    <div class="glass-card mb-6 rounded-2xl p-6">
      <h2 class="mb-3 text-lg font-bold text-cyan-300">申请格式</h2>
      <p class="mb-2 text-sm text-gray-400">请在评论区按如下格式提交信息，点击「一键填充」自动填入评论框：</p>
      <pre id="apply-template" class="overflow-x-auto rounded-lg bg-black/30 p-4 text-sm text-gray-300">
{`{
  name: "名称",
  url: "地址",
  avatar: "头像",
  desc: "描述"
}`}</pre>
      <div class="mt-3">
        <button id="fill-btn" class="rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-4 py-2 text-sm text-cyan-300 transition-colors hover:bg-cyan-500/20">
          一键填充申请内容
        </button>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-6">
      <h2 class="mb-3 text-lg font-bold text-cyan-300">提交申请</h2>
      <p class="mb-4 text-sm text-gray-400">提交后我会尽快查看。若信息不完整或暂未满足要求，我会在评论区说明原因。</p>
      <Twikoo />
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var fillBtn = document.getElementById('fill-btn');
    if (fillBtn) {
      fillBtn.addEventListener('click', function() {
        var commentBox = document.querySelector('#tcomment textarea, .twikoo .el-textarea textarea') ||
                         document.querySelector('#tcomment .el-input textarea') ||
                         document.querySelector('.twikoo textarea');
        if (commentBox) {
          var template = `名称：\n地址：\n头像：\n描述：`;
          commentBox.value = template;
          commentBox.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
    }
  });
</script>

<style is:global>
  .glass-card { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.06); }
</style>
