---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="关于 - 茗辰原" description="茗辰原的个人介绍页面">
  <main class="mx-auto max-w-4xl px-4 py-12">
    <!-- 头部名片 -->
    <div class="glass-card mb-8 flex flex-col items-center gap-6 rounded-2xl p-8 text-center md:flex-row md:text-left">
      <img src="https://mingcy.cn/image/mcy.png" alt="茗辰原" class="h-32 w-32 flex-shrink-0 rounded-full border-4 border-cyan-400/50 shadow-lg shadow-cyan-500/20" />
      <div>
        <h1 class="bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-4xl font-bold text-transparent">茗辰原</h1>
        <p class="mt-2 text-lg text-gray-400">一名学生、创意有趣的编程爱好者</p>
        <p class="mt-1 text-sm text-gray-500">🌏 中国 · 新疆 · 乌鲁木齐 &nbsp;|&nbsp; 🎂 2007.03.29 &nbsp;|&nbsp; ♈ 白羊座</p>
        <div class="mt-3 flex flex-wrap justify-center gap-2 md:justify-start">
          <span class="glass-btn rounded-lg px-3 py-1 text-sm text-cyan-300">INFJ-T</span>
          <span class="glass-btn rounded-lg px-3 py-1 text-sm text-gray-400">学生</span>
          <span class="glass-btn rounded-lg px-3 py-1 text-sm text-gray-400">网络安全</span>
        </div>
      </div>
    </div>

    <!-- 座右铭 -->
    <div class="glass-card mb-8 rounded-2xl p-6 text-center">
      <p class="text-xl italic text-cyan-300">「 源于热爱而去创造 」</p>
    </div>

    <!-- 技能 -->
    <div class="glass-card mb-8 rounded-2xl p-6">
      <h2 class="mb-6 text-xl font-bold text-white">技能</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-3">
        {
          [
            { name: "HTML", level: 90, color: "#e9572b" },
            { name: "JavaScript", level: 80, color: "#f7cb4f" },
            { name: "Git", level: 75, color: "#df5b40" },
            { name: "TypeScript", level: 70, color: "#3178c6" },
            { name: "Python", level: 65, color: "#3776ab" },
            { name: "CSS", level: 85, color: "#1572b6" },
          ].map((skill) => (
            <div class="flex flex-col items-center gap-2">
              <div class="relative flex h-20 w-20 items-center justify-center">
                <svg class="h-20 w-20 -rotate-90" viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="6"/>
                  <circle cx="40" cy="40" r="34" fill="none" stroke={skill.color} stroke-width="6"
                    stroke-dasharray={2 * Math.PI * 34}
                    stroke-dashoffset={2 * Math.PI * 34 * (1 - skill.level / 100)}
                    stroke-linecap="round"/>
                </svg>
                <span class="absolute text-sm font-bold text-white">{skill.level}%</span>
              </div>
              <span class="text-sm text-gray-400">{skill.name}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 生涯时间线 -->
    <div class="glass-card mb-8 rounded-2xl p-6">
      <h2 class="mb-6 text-xl font-bold text-white">生涯</h2>
      <div class="space-y-6">
        {
          [
            { date: "2007-03-29", title: "出生", desc: "新疆乌鲁木齐" },
            { date: "2024", title: "开始编程之旅", desc: "接触 Web 开发，创建第一个博客" },
            { date: "2025", title: "持续学习与分享", desc: "网络安全方向学习，撰写技术文章" },
            { date: "2026", title: "博客升级", desc: "迁移到 Astro Devosfera，全新的体验" },
          ].map((item) => (
            <div class="relative border-l-2 border-cyan-500/30 pl-5">
              <div class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full bg-cyan-400 shadow shadow-cyan-400/50"/>
              <span class="text-xs font-mono text-cyan-400">{item.date}</span>
              <h3 class="mt-1 text-white">{item.title}</h3>
              <p class="text-sm text-gray-400">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 游戏 & 兴趣 -->
    <div class="grid gap-6 md:grid-cols-2">
      <div class="glass-card rounded-2xl p-6">
        <h2 class="mb-4 text-xl font-bold text-white">🎮 游戏</h2>
        <ul class="space-y-2 text-sm text-gray-300">
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-cyan-400"></span>香肠派对 — 单四 KD:9.9</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-purple-400"></span>和平精英 — 单排 KD:3.77</li>
          <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-yellow-400"></span>光遇 — 跑图大师</li>
        </ul>
      </div>
      <div class="glass-card rounded-2xl p-6">
        <h2 class="mb-4 text-xl font-bold text-white">🏷️ 标签</h2>
        <div class="flex flex-wrap gap-2">
          {["数码科技", "智能家居", "开源", "数理化", "音乐", "分享"].map((t) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-gray-300">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- 页脚 -->
    <div class="mt-8 text-center text-sm text-gray-500">
      <img src="https://webp.mingcy.cn" alt="random" class="mx-auto mt-4 h-24 w-48 rounded-lg object-cover opacity-70"/>
    </div>
  </main>
</Layout>

<style is:global>
  .glass-card { background: rgba(255,255,255,0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.06); }
  .glass-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); }
</style>
